#
# Sao chép thành .env rồi chạy `make up`. Mọi giá trị dưới đây chỉ là giá trị mẫu
# cho môi trường phát triển; đổi mật khẩu và khóa trước khi chạy trên Internet.

# ---- Phiên bản image (ghim cụ thể, không dùng latest) -------------------------
POSTGRES_VERSION=17.11-alpine
POSTGREST_VERSION=v16.4
KEYCLOAK_VERSION=26.8.1
APISIX_VERSION=3.19.0-debian
CLAMAV_VERSION=1.5.4
SEAWEEDFS_VERSION=3.99
N8N_VERSION=2.44.4

# ---- Cổng công bố ra máy chủ ---------------------------------------------------
APISIX_PORT=9080
KEYCLOAK_PORT=8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# ---- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=dxdesk
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password
N8N_DB=n8n
N8N_DB_PASSWORD=n8n_dev_password
AUTHENTICATOR_PASSWORD=authenticator_dev_password

# ---- PostgREST ----------------------------------------------------------------
PGRST_DB_SCHEMAS=public

# ---- Keycloak -----------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_REALM=dxdesk

# ---- SeaweedFS (S3 API) -------------------------------------------------------
S3_ACCESS_KEY=dxdesk_dev_access_key
S3_SECRET_KEY=dxdesk_dev_secret_key
S3_BUCKET=dxdesk-attachments

# ---- n8n ----------------------------------------------------------------------
# Khóa mã hóa credentials của n8n; đổi khi chạy thật.
N8N_ENCRYPTION_KEY=dxdesk_dev_encryption_key_change_me
