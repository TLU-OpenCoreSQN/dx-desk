{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dxdesk.local/config/schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 TLU-OpenCoreSQN\nSPDX-License-Identifier: Apache-2.0",
  "title": "DX-Desk enterprise configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "modules", "teams", "categories", "routing", "sla_policies"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "schema_version": { "const": 1 },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "core" },
          "items": { "enum": ["core", "desk", "devices", "data"] }
        }
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "active"],
        "properties": {
          "code": { "$ref": "#/definitions/code" },
          "name": { "$ref": "#/definitions/name" },
          "active": { "type": "boolean" }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "description", "active", "requirement_fields"],
        "properties": {
          "code": { "$ref": "#/definitions/code" },
          "name": { "$ref": "#/definitions/name" },
          "description": { "type": "string", "pattern": "^[^\\u0000]*$" },
          "active": { "type": "boolean" },
          "requirement_fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label", "required"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                "label": { "$ref": "#/definitions/name" },
                "required": { "type": "boolean" },
                "type": { "const": "string" },
                "placeholder": { "$ref": "#/definitions/guide_text" },
                "hint": { "$ref": "#/definitions/guide_text" }
              }
            }
          }
        }
      }
    },
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "team", "active"],
        "properties": {
          "category": { "$ref": "#/definitions/code" },
          "team": { "$ref": "#/definitions/code" },
          "active": { "type": "boolean" }
        }
      }
    },
    "sla_policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "low": { "$ref": "#/definitions/sla" },
        "normal": { "$ref": "#/definitions/sla" },
        "high": { "$ref": "#/definitions/sla" },
        "critical": { "$ref": "#/definitions/sla" }
      }
    }
  },
  "definitions": {
    "code": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,39}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^(?!.*\\u0000).*\\S.*$" },
    "guide_text": { "type": "string", "maxLength": 200, "pattern": "^[^\\u0000]*$" },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_minutes", "resolution_minutes"],
      "properties": {
        "response_minutes": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "resolution_minutes": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    }
  }
}
