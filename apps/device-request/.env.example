# Keycloak OIDC: cùng realm với DX-Desk, client riêng của ứng dụng 2
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=dxdesk
VITE_KEYCLOAK_CLIENT_ID=dxdesk-device

# PostgREST qua APISIX (cùng origin)
VITE_REST_BASE_URL=/rest

# Đích proxy khi chạy vite dev (cần stack đang chạy)
VITE_PROXY_TARGET=http://localhost:9080
