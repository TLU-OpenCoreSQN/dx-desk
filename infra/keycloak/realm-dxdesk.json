{
  "realm": "dxdesk",
  "displayName": "DX-Desk",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 900,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "Employee",
        "description": "Nhân viên gửi yêu cầu IT"
      },
      {
        "name": "Agent",
        "description": "Kỹ thuật viên xử lý ticket"
      },
      {
        "name": "Manager",
        "description": "Quản lý, được đặt mức Critical và duyệt yêu cầu"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dxdesk-web",
      "name": "DX-Desk web (React)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:9080/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "dxdesk-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "db-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "claim.value": "authenticated",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "dxdesk-api",
      "name": "DX-Desk Service Desk API",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "appsmith",
      "name": "Appsmith (thử nghiệm TN-01)",
      "enabled": true,
      "publicClient": false,
      "secret": "appsmith-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "dxdesk-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "db-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "claim.value": "authenticated",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "wikijs",
      "name": "Wiki.js tri thức DX-Desk",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:18030/login/keycloak/callback"
      ],
      "webOrigins": [
        "http://localhost:18030"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:18030/*"
      },
      "protocolMappers": [
        {
          "name": "dxdesk-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "dxdesk_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "access.token.claim": "false"
          }
        }
      ]
    }
  ],
